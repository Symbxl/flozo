# Twitch channel name (the part after twitch.tv/), e.g. "ninja"
TWITCH_CHANNEL=

# Twitch application credentials, from https://dev.twitch.tv/console/apps
# Used server-side only, to check whether the channel is live and to look up
# the most recent VOD. Never exposed to the browser.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Last-resort hero video, used only when the channel is offline AND has no
# past broadcasts (or Twitch can't be reached).
# Defaults to /hero.mp4 (i.e. public/hero.mp4).
HERO_VIDEO_SRC=
HERO_VIDEO_POSTER=

# Address shown as the direct-email fallback in the Contact section.
# Defaults to contact@flozo712.com.
CONTACT_EMAIL=

# Contact form delivery, via the Resend HTTP API (https://resend.com).
# All three are required in production; without them the form logs the
# submission in development and fails loudly in production.
#   CONTACT_FROM_EMAIL must be on a domain verified with Resend.
#   CONTACT_TO_EMAIL is your own inbox; replies go to the sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
